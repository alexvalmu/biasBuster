# Copy to .env and fill in. In production these come from Cloud Run env vars / Secret Manager.

# --- LLMs (OpenRouter) ---
OPENROUTER_API_KEY=
# Must support tool calling + structured outputs on OpenRouter (filter "tools" on openrouter.ai/models)
LLM_MODEL_FAST=qwen/qwen3-30b-a3b-instruct-2507
LLM_MODEL_AGENT=deepseek/deepseek-chat-v3.1

# --- Data sources ---
TAVILY_API_KEY=
# Optional, raises PubMed rate limit from 3 to 10 req/s
NCBI_API_KEY=
# Sent to OpenAlex / Crossref / NCBI for their "polite" pools
CONTACT_EMAIL=contact@biasbuster.app
# CMS Open Payments "General Payment Data" dataset id for the year to query (optional)
OPEN_PAYMENTS_DATASET_ID=

# --- Limits ---
MAX_DAILY_ANALYSES=200
RATE_LIMIT_NEW_ANALYSES=5/day
MAX_AUTHORS_INVESTIGATED=8
# Optional reCAPTCHA v3 secret; leave empty to disable captcha checks
RECAPTCHA_SECRET=

# --- Dev ---
CORS_ORIGINS=["http://localhost:5173"]
